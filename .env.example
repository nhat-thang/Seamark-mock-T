# Sao chép file này thành .env rồi điền giá trị thật.
# Trên máy dev: DATA_DIR=./data
# Trên VPS:     DATA_DIR=C:\toeic\data
# Đường dẫn Windows: viết thẳng, KHÔNG đặt trong dấu nháy kép ("C:\toeic\new" sẽ bị hiểu \n là xuống dòng).

PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Thư mục chứa database SQLite và file upload (audio, ảnh)
DATA_DIR=./data

# Chuỗi bí mật ký phiên đăng nhập. Tạo chuỗi ngẫu nhiên dài, KHÔNG dùng chung giữa máy dev và VPS
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Tài khoản admin chính (owner) được tạo lần đầu khi chạy lệnh seed.
# Sau khi tạo, đổi mật khẩu ngay trên web (mục "Đổi mật khẩu"); sửa OWNER_PASSWORD ở đây không còn tác dụng.
# Mật khẩu không chứa dấu cách, dấu # và dấu nháy.
OWNER_USERNAME=owner
OWNER_PASSWORD=doi-mat-khau-nay
OWNER_DISPLAY_NAME=Thom Tran

# Giới hạn dung lượng upload mỗi file (MB). Không đặt quá 95: Cloudflare (gói Free) chặn request trên 100 MB.
MAX_UPLOAD_MB=95

# AI kiểm tra đề dán vào (Google Gemini) — KHÔNG bắt buộc. Để trống thì tính năng "Dán đề" vẫn tự tách đề, chỉ bỏ bước AI.
# Lấy key miễn phí ở https://aistudio.google.com/apikey (đăng nhập tài khoản Google của trung tâm). Key là bí mật, không gửi cho ai.
AI_API_KEY=
# Mẫu AI (để trống = gemini-flash-latest, luôn là mẫu Flash mới nhất)
AI_MODEL=
# Số lần gọi AI tối đa mỗi ngày (một đề 200 câu tốn khoảng 8 lần)
AI_DAILY_LIMIT=300

# Thư mục chứa bản sao lưu (lệnh: npm run backup). Nên đặt ở ổ đĩa khác ổ chứa DATA_DIR (nếu có).
# Để trống thì dùng DATA_DIR\backups
BACKUP_DIR=
